{
  "name": "epicountdown",
  "version": "1.0.0",
  "description": "Live countdown timers for TV shows and anime episodes",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "lint": "eslint app.js",
    "lint:fix": "eslint app.js --fix",
    "format": "prettier --write \"*.{js,html,css,json,md}\"",
    "format:check": "prettier --check \"*.{js,html,css,json,md}\"",
    "serve": "python -m http.server 8000"
  },
  "keywords": [
    "countdown",
    "tv-shows",
    "anime",
    "episodes",
    "tvmaze",
    "jikan",
    "myanimelist"
  ],
  "author": "Anuraag Rao",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/countdown.git"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "prettier": "^3.2.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
